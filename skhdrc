#############################################
# WINDOW FOCUS (DIRECTIONAL)
#############################################

cmd - left  : yabai -m window --focus west
cmd - down  : yabai -m window --focus south
cmd - up    : yabai -m window --focus north
cmd - right : yabai -m window --focus east


#############################################
# SWAP WINDOW POSITION
#############################################

cmd + shift - left  : yabai -m window --swap west
cmd + shift - down  : yabai -m window --swap south
cmd + shift - up    : yabai -m window --swap north
cmd + shift - right : yabai -m window --swap east


############################################
RESIZE WINDOW (GROW / SHRINK)
############################################

# Grow window
alt + ctrl - right : yabai -m window --resize right:40:0
alt + ctrl - left  : yabai -m window --resize left:40:0

# Shrink window
alt + ctrl + shift - right : yabai -m window --resize right:-40:0
alt + ctrl + shift - left  : yabai -m window --resize left:-40:0

# Maximize window (yabai fullscreen, stays tiled)
shift + alt - up : yabai -m window --toggle zoom-parent

# Balance all windows
shift + alt - down : yabai -m space --balance


#############################################
# FLOATING WINDOW CONTROLS
#############################################

# Toggle float and center
shift + cmd - space : yabai -m window --toggle float --grid 4:4:1:1:2:2


